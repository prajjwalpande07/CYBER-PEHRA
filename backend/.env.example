PROJECT_NAME="CYBER PEHRA - Predictive Intelligence & Multi-Agency Cybercrime Intervention Grid"
ENVIRONMENT=production
DEBUG=False
API_V1_PREFIX=/api

# Database
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/cyberpehra
# SQLite Fallback: sqlite:///./cyberpehra.db
DATABASE_URL=sqlite:///./cyberpehra.db

# Security & JWT
SECRET_KEY=cyberpehra_national_cybercrime_coordination_secret_key_2026_super_secure_token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Model Storage
MODEL_DIR=./app/ml/weights
MODEL_FILE=prototype_rf_model.joblib
